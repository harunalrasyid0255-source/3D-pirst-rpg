/* =============================================
   MainMenuStyle.uss — Gaya RPG Gelap Elegan
   Gunakan bersama MainMenu.uxml
   ============================================= */

/* --- Latar seluruh layar --- */
.container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: flex-start;      /* Menu rata kiri; karakter 3D bisa berdiri di kanan */
    padding-left: 80px;
    background-color: rgba(10, 12, 20, 0.45);
}

/* --- Judul Game --- */
.title {
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(255, 215, 110);
    text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.9);
    margin-bottom: 4px;
}

/* --- Subjudul / Genre --- */
.subtitle {
    font-size: 20px;
    color: rgb(210, 220, 240);
    margin-bottom: 45px;
    letter-spacing: 3px;
}

/* --- Kelompok tombol --- */
.button-group {
    width: 300px;
}

/* --- Gaya dasar semua tombol --- */
.menu-btn {
    height: 52px;
    margin-bottom: 14px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
    background-color: rgba(25, 30, 45, 0.85);
    border-color: rgb(180, 145, 70);
    border-width: 2px;
    border-radius: 6px;
    transition-duration: 0.15s;
    transition-property: background-color, scale, color;
}

/* --- Hover: semua tombol --- */
.menu-btn:hover {
    background-color: rgb(215, 165, 60);
    color: rgb(15, 15, 20);
    scale: 1.05 1.05;
}

/* --- Active (saat diklik) --- */
.menu-btn:active {
    scale: 0.98 0.98;
}

/* --- Tombol utama (Mulai Petualangan) — border lebih terang --- */
.primary-btn {
    border-color: rgb(255, 215, 110);
    border-width: 2px;
}

/* --- Tombol Keluar: hover merah --- */
.quit-btn:hover {
    background-color: rgb(200, 55, 55);
    border-color: rgb(255, 120, 120);
    color: white;
}
